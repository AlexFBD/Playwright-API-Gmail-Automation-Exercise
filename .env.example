# OAuth 2.0 credentials for a Google Cloud project with the Gmail API enabled.
# The refresh token must have been granted the https://mail.google.com/ scope.
GMAIL_CLIENT_ID=GOOGLE_CLIENT_ID_PLACEHOLDER
GMAIL_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_PLACEHOLDER
GMAIL_REFRESH_TOKEN=GOOGLE_REFRESH_TOKEN_PLACEHOLDER

# Permanent deletion is opt-in. Leave false for a non-destructive API check.
CONFIRM_DELETE_SPAM_FIRST=false
CONFIRM_DELETE_SPAM_ALL=false

CONFIRM_DELETE_BIN_FIRST=false
CONFIRM_DELETE_BIN_ALL=false
