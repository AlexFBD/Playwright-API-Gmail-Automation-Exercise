{
  "name": "gmail-spam-cleaner",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright checks for the Gmail login page and a Gmail API integration test that can empty Spam.",
  "scripts": {
    "pw:test": "playwright test",
    "pw:login": "playwright test tests/login-page.spec.ts",
    "pw:gmail-api": "playwright test tests/gmail-spam.spec.ts",
    "pw:headed": "playwright test --headed",
    "pw:report": "playwright show-report",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  }
}
